# Backend Environment Variables Example
# Copy this file to .env and update the values

# Security
SECRET_KEY=ai-go-secret-key-2025-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=mysql+pymysql://app_user:app_pass@mariadb:3306/ai_go?charset=utf8mb4
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ai_go
DB_USER=app_user
DB_PASSWORD=app_pass
CREATE_TABLE_ON_START=true

# CORS
ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:8080,http://127.0.0.1:8080

# Video URL Whitelist
VIDEO_URL_WHITELIST=youtube.com,youtu.be,vimeo.com,drive.google.com,s3.amazonaws.com,cloudfront.net

# Development
DEBUG=true
LOG_LEVEL=INFO