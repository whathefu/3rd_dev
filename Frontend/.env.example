# Frontend Environment Variables Example
# Copy this file to .env for development

# Backend API Base URL (without /api/v1 suffix)
VITE_API_BASE_URL=http://localhost:8080

# Development settings
NODE_ENV=development
VITE_NODE_ENV=development

# Optional: Debug mode
VITE_DEBUG=true

# App metadata
VITE_APP_NAME=AI-GO
VITE_APP_VERSION=1.0.0

# Production Example:
# VITE_API_BASE_URL=https://api.ai-go.com
# NODE_ENV=production
# VITE_NODE_ENV=production
# VITE_DEBUG=false